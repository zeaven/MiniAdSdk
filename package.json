{
  "name": "minigame-ad-sdk",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "build:prod": "tsc && javascript-obfuscator --config obfuscate.config.js --output dist/ temp/vscode-dist/",
    "obfuscate": "javascript-obfuscator --config obfuscate.config.js --output dist/ temp/vscode-dist/",
    "clean": "rm -rf temp dist",
    "prepack": "npm run build:prod",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "typescript": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^14.0.0",
    "javascript-obfuscator": "^4.1.1",
    "typescript": "^4.0.0"
  }
}
