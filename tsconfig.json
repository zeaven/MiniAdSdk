{
  "compilerOptions": {
    "module": "commonjs",
    "lib": [ "es2015", "es2017", "dom" ],
    "target": "es5",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "outDir": "temp/core",
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ],
    "paths": {
      "adapter": ["./core/adapters/huawei/HuaweiAd.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "library",
    "local",
    "temp",
    "build", 
    "settings",
    "**/*.spec.ts"  // 添加测试文件排除
  ]
}